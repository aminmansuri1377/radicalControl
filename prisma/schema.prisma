generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Language {
  id                       String                       @id @default(cuid())
  code                     String                       @unique
  name                     String
  enabled                  Boolean                      @default(true)
  sortOrder                Int                          @default(0)
  createdAt                DateTime                     @default(now())
  categoryTranslations     CategoryTranslation[]
  contentTranslations      ContentTranslation[]
  tickerTranslations       PriceTickerTranslation[]
  productTranslations      ProductTranslation[]
  attributeTranslations    AttributeTranslation[]
  attributeValueTranslations AttributeValueTranslation[]
}

model Category {
  id           String                @id @default(cuid())
  slug         String                @unique
  imageUrl     String
  published    Boolean               @default(true)
  sortOrder    Int                   @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  // --- درخت خودارجاع ---
  parentId     String?
  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     Category[]            @relation("CategoryTree")

  translations CategoryTranslation[]
  products     Product[]

  @@index([published])
  @@index([parentId])
}
model CategoryTranslation {
  id             String   @id @default(cuid())
  categoryId     String
  languageId     String
  name           String
  slug           String
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  language       Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([categoryId, languageId])
  @@unique([languageId, slug])

}

model Product {
  id           String               @id @default(cuid())
  slug         String               @unique
  imageUrl     String
  images       Json?
  categoryId   String
  published    Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  category     Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  translations ProductTranslation[]
  attributeValues ProductAttributeValue[]

  @@index([categoryId])
  @@index([published])
}

model ProductTranslation {
  id             String   @id @default(cuid())
  productId      String
  languageId     String
  name           String
  slug           String
  description    String
  specifications String
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  language       Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, languageId])
  @@unique([languageId, slug])

}

model Content {
  id           String               @id @default(cuid())
  slug         String               @unique
  type         ContentType
  coverImage   String
  images Json?
  published    Boolean              @default(false)
  publishedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  translations ContentTranslation[]

  @@index([type])
  @@index([published])
}

model ContentTranslation {
  id             String   @id @default(cuid())
  contentId      String
  languageId     String
  title          String
  slug           String
  excerpt        String?
  body           String
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  content        Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  language       Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([contentId, languageId])
}

model PriceTicker {
  id           String                   @id @default(cuid())
  active       Boolean                  @default(true)
  imageUrl      String?
  sortOrder    Int                      @default(0)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  translations PriceTickerTranslation[]

  @@index([active])
  @@index([sortOrder])
}

model PriceTickerTranslation {
  id          String      @id @default(cuid())
  tickerId    String
  languageId  String
  productName String
  price       String
  language    Language    @relation(fields: [languageId], references: [id], onDelete: Cascade)
  ticker      PriceTicker @relation(fields: [tickerId], references: [id], onDelete: Cascade)

  @@unique([tickerId, languageId])
}
model ContactRequest {
  id String @id @default(cuid())

  fullName String
  companyName String?
  phone     String?
  email     String?

  subject String?

  message String @db.Text

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}
enum ContentType {
  BLOG
  NEWS
  ARTICLE
}

// ============================================================================
//  ویژگی‌های محصول (Attributes)
//  هر Attribute (مثل رنگ، وزن، جنس) چند مقدار (AttributeValue) دارد و هر مقدار
//  می‌تواند چندزبانه باشد. ارتباط با محصول از طریق ProductAttributeValue انجام
//  می‌شود که فقط productId و valueId را نگه می‌دارد (attribute از طریق value قابل
//  دسترسی است تا از ناسازگاری داده جلوگیری شود).
// ============================================================================

model Attribute {
  id          String                 @id @default(cuid())
  slug        String                 @unique
  published   Boolean                @default(true)
  filterable  Boolean                @default(true)
  sortOrder   Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  translations AttributeTranslation[]
  values       AttributeValue[]

  @@index([published])
  @@index([filterable])
}

model AttributeTranslation {
  id          String    @id @default(cuid())
  attributeId String
  languageId  String
  name        String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  language    Language  @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([attributeId, languageId])
}

model AttributeValue {
  id          String                       @id @default(cuid())
  slug        String                       @unique
  attributeId String
  sortOrder   Int                          @default(0)
  createdAt   DateTime                     @default(now())

  attribute    Attribute                  @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  translations AttributeValueTranslation[]
  products     ProductAttributeValue[]

  @@index([attributeId])
}

model AttributeValueTranslation {
  id         String          @id @default(cuid())
  valueId    String
  languageId String
  label      String
  value      AttributeValue  @relation(fields: [valueId], references: [id], onDelete: Cascade)
  language   Language        @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([valueId, languageId])
}

// جدول اتصال محصول ↔ مقدار ویژگی (منبع حقیقتِ نسبت دادن ویژگی‌ها به محصول)
model ProductAttributeValue {
  id        String         @id @default(cuid())
  productId String
  valueId   String

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  value   AttributeValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@unique([productId, valueId])
  @@index([productId])
  @@index([valueId])
}
